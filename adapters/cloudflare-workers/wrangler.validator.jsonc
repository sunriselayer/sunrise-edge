{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sunrise-edge-experimental-validator",
  "main": "src/validator/index.ts",
  // Newest date supported by the repository-pinned workerd binary.
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  // This is a local integration profile. No default public route is enabled.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "VALIDATOR_STATE", "class_name": "ValidatorObject" }
    ]
  },
  "migrations": [
    { "tag": "validator-sqlite-v1", "new_sqlite_classes": ["ValidatorObject"] }
  ],
  "vars": {
    "VALIDATOR_ACTOR_NAME": "unconfigured",
    "VALIDATOR_GENESIS": ""
  },
  "secrets": {
    "required": ["VALIDATOR_CONFIG", "VALIDATOR_BEARER_TOKEN"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
